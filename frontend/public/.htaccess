Options -Indexes

RewriteEngine On
RewriteBase /

# Serve existing files and directories directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# SPA fallback: dynamic ERP routes → placeholder pre-rendered page
RewriteRule ^app/consultas/([^/]+)(/.*)?$ /app/consultas/1/index.html [L]
RewriteRule ^app/cotizaciones/([^/]+)(/.*)?$ /app/cotizaciones/1/index.html [L]
RewriteRule ^app/facturas/([^/]+)(/.*)?$ /app/facturas/1/index.html [L]
RewriteRule ^app/ordenes-compra/([^/]+)(/.*)?$ /app/ordenes-compra/1/index.html [L]
RewriteRule ^app/pacientes/([^/]+)(/.*)?$ /app/pacientes/1/index.html [L]
RewriteRule ^app/pedidos/([^/]+)(/.*)?$ /app/pedidos/1/index.html [L]
RewriteRule ^app/roles/([^/]+)(/.*)?$ /app/roles/1/index.html [L]
RewriteRule ^app/clientes/([^/]+)(/.*)?$ /app/clientes/1/index.html [L]
