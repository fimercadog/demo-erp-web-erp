APP_NAME=VetPanel
APP_ENV=production
APP_KEY=                          # php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://demo-erp-web-veterinaria-api.fidelmercadotech.com
APP_TIMEZONE=America/Bogota

FRONTEND_URL=https://demo-erp-web-veterinaria.fidelmercadotech.com
# Si el frontend tiene otro dominio o www, agregarlo aquí separado por coma
CORS_EXTRA_ORIGINS=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_CO

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ── Base de datos MySQL (Hostinger) ──────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u[cuenta]_vetpanel     # reemplaza con el nombre real
DB_USERNAME=u[cuenta]_vetuser      # reemplaza con el usuario real
DB_PASSWORD=                       # contraseña fuerte

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.fidelmercadotech.com

# Frontend en otro dominio → cookies cross-site
SESSION_SAME_SITE=none
SESSION_SECURE_COOKIE=true
SANCTUM_STATEFUL_DOMAINS=demo-erp-web-veterinaria.fidelmercadotech.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=                     # tu correo en Hostinger
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=noreply@fidelmercadotech.com
MAIL_FROM_NAME="VetPanel"

VITE_APP_NAME="${APP_NAME}"
